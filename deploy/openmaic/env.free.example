# OpenMAIC — TTS tiếng Việt chuẩn qua Javis Edge-TTS (không Browser Native)
# Sao chép thành .env.local trên máy chủ (script deploy làm giúp).
# KHÔNG commit file có API key thật.

# --- LLM (bắt buộc để generate classroom) ---
GOOGLE_API_KEY=
DEFAULT_PROVIDER=google
DEFAULT_MODEL=google:gemini-3.6-flash

# --- TTS: Javis Edge-TTS (Hoài My / Nam Minh) qua OpenAI-compatible proxy ---
# OpenMAIC → POST {TTS_OPENAI_BASE_URL}/audio/speech → Javis /v1/audio/speech
TTS_BROWSER_NATIVE_ENABLED=false
TTS_OPENAI_ENABLED=true
TTS_OPENAI_API_KEY=
# host.docker.internal (Linux: --add-host) hoặc IP bridge Docker
TTS_OPENAI_BASE_URL=http://host.docker.internal:7777/v1

# --- Clone giọng (tuỳ chọn, sau này) ---
# TTS_ELEVENLABS_API_KEY=
# TTS_VOXCPM_BASE_URL=http://127.0.0.1:8000/v1

# --- Mật khẩu site (thường TẮT — cửa chính = Javis Bài giảng) ---
# Bật chỉ khi muốn khóa domain openmaic công khai:
# ACCESS_CODE=vietmy-openmaic

# App
NODE_ENV=production
PORT=3000
