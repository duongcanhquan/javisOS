# OpenMAIC — profile MIỄN PHÍ (TTS) trên VPS
# Sao chép thành .env.local trên máy chủ (script deploy làm giúp).
# KHÔNG commit file có API key thật.

# --- LLM (bắt buộc để generate classroom; TTS miễn phí vẫn cần LLM) ---
# Ưu tiên Gemini free tier. Script deploy có thể lấy từ Javis Models nếu đã dán key.
GOOGLE_API_KEY=
DEFAULT_PROVIDER=google
DEFAULT_MODEL=google:gemini-2.5-flash

# --- TTS miễn phí (mặc định) ---
# Browser Native: dùng giọng hệ điều hành / Chrome (tiếng Việt Google trên Chrome rất ổn).
# Học viên mở classroom bằng Chrome → Settings → Text-to-Speech → Browser Native.
TTS_BROWSER_NATIVE_ENABLED=true

# Tắt các TTS trả phí cho đến khi bạn chủ động thêm key
TTS_OPENAI_ENABLED=false
# TTS_AZURE_API_KEY=
# TTS_ELEVENLABS_API_KEY=
# TTS_MINIMAX_API_KEY=
# TTS_QWEN_API_KEY=

# --- Clone giọng (tuỳ chọn, KHÔNG bật mặc định trên VPS CPU) ---
# VoxCPM2 cần máy GPU hoặc máy riêng đủ mạnh. Khi đã chạy backend:
#   TTS_VOXCPM_BASE_URL=http://127.0.0.1:8000/v1
# rồi trong OpenMAIC: Settings → TTS → VoxCPM2 → Clone voice (upload mẫu).
# TTS_VOXCPM_BASE_URL=

# App
NODE_ENV=production
PORT=3000
