# Javis gốc trên javis.vietmycollege.com: Javis đầy đủ + quản trị tổ chức.
# Volume MỚI - không trỏ javis_javis-* (não cá nhân ở javis-quan).
# Soạn skill/agent/workflow chung trên brain org-catalog rồi đẩy xuống tenant.

JAVIS_NAME=javis-manager
DOMAIN_NAME=javis.vietmycollege.com
JAVIS_BIND=127.0.0.1
JAVIS_HOST_PORT=7778
JAVIS_ORG_MANAGER=true
JAVIS_ORG_HOST_PREFIX=vmos
JAVIS_ORG_CATALOG_BRAIN=org-catalog
# DOCKER_GID điền lúc deploy (stat /var/run/docker.sock) - user javis mới tạo được Javis con.
JAVIS_ADMIN_USER=admin
JAVIS_ADMIN_PASSWORD=admin
