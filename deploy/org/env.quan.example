# Bản cá nhân (não hiện tại). Copy thành /root/javis/.env
# GIỮ compose project `javis` (volume javis_javis-*). Chỉ đổi tên container + domain.
#
# COMPOSE_PROJECT_NAME=javis

JAVIS_NAME=javis-quan
DOMAIN_NAME=javis-quan.vietmycollege.com
JAVIS_BIND=127.0.0.1
JAVIS_HOST_PORT=7777
JAVIS_DATA_VOLUME=javis_javis-data
JAVIS_BRAINS_VOLUME=javis_javis-brains
JAVIS_CLAUDE_VOLUME=javis_claude-auth
JAVIS_CODEX_VOLUME=javis_codex-auth
