# Javis con trường (không phải gốc, không phải javis-quan).
# Copy thành /root/javis-<slug>/.env rồi up kèm docker-compose.tenant-limits.yml.

JAVIS_NAME=javis-ten
DOMAIN_NAME=javis-ten.vietmycollege.com
JAVIS_BIND=127.0.0.1
JAVIS_HOST_PORT=7780
JAVIS_ORG_MANAGER=false

# Trần ổ (app chặn ghi khi vượt; Docker chưa gán quota kernel đợt 1)
JAVIS_QUOTA_GB=2

# Trần RAM/CPU (cgroup). Gốc và quan không file này.
JAVIS_MEM_LIMIT=1024m
JAVIS_CPUS=0.75
JAVIS_PIDS_LIMIT=256

# Plugin Python trong process: tắt. Skill/agent markdown vẫn tạo được trong trần ổ.
JAVIS_ENABLE_USER_PLUGINS=false
JAVIS_KANBAN_MAX_WORKERS=1
JAVIS_ENABLE_PIXELLE=false
