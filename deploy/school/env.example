# Sao chép thành .env cạnh docker-compose.yml rồi sửa.
JAVIS_IMAGE=ghcr.io/duongcanhquan/javisos:latest
JAVIS_NAME=javis
JAVIS_HOST_PORT=7777
JAVIS_BIND=0.0.0.0

JAVIS_ADMIN_USER=admin
JAVIS_ADMIN_PASSWORD=doi-mat-khau-nay

JAVIS_ENABLE_USER_PLUGINS=true
GEMINI_FORCE_FILE_STORAGE=true

# Nếu có OpenMAIC trên cùng VPS (tuỳ chọn):
# OPENMAIC_BASE_URL=http://host.docker.internal:3000
# OPENMAIC_PUBLIC_URL=http://IP-HOAC-DOMAIN:3000
